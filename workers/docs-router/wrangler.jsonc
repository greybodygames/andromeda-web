{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "andromeda-docs-router",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_HOST": "andromeda.greybodygames.com",
    "DOCS_PATH_PREFIX": "/docs",
    "AUTH_SIGN_IN_URL": "https://auth.greybodygames.com/oauth2/sign_in",
  },
  "vpc_services": [
    {
      "binding": "TRAEFIK_ORIGIN",
      "service_id": "01a0d3ad-c157-7782-93ef-bd8b713b8c57",
    },
  ],
  "routes": [
    {
      "pattern": "andromeda.greybodygames.com/docs*",
      "zone_name": "greybodygames.com",
    },
  ],
}
