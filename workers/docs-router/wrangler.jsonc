{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "andromeda-docs-router",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_HOST": "andromeda.greybodygames.com",
    "DOCS_ORIGIN": "https://andromeda-docs.greybodygames.com",
    "DOCS_PATH_PREFIX": "/docs",
  },
  "routes": [
    {
      "pattern": "andromeda.greybodygames.com/docs*",
      "zone_name": "greybodygames.com",
    },
  ],
}
